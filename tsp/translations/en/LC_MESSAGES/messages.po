#: templates/index.html:33
msgid ""
"Ho vi, ĉiuj soifantoj, iru al la akvo, kaj vi, kiuj ne havas\n"
"            monon; iru, aĉetu, kaj manĝu; iru, aĉetu sen mono\n"
"            kaj sen pago vinon kaj lakton"
msgstr ""
"Ho, every one that thirsteth, come ye to the waters, and he that hath\n"
"           no money; come ye, buy, and eat; yea, come, buy wine and milk\n"
"           without money and without price."

